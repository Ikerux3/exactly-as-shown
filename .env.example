# Server-only. Never expose this as a VITE_* variable.
GEMINI_API_KEY=

# Optional override. Keep a fast structured-output model for this short interaction.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional image model for one-off favourite-toy props. Generated images are
# cached in the browser; if unavailable, the matching static toy stays visible.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional server-only character voices. If absent or unavailable, the browser's
# built-in English TTS is used automatically and subtitles always remain visible.
# Keep this false while validating dialogue timing and browser fallback. Voice IDs
# can be configured safely in advance: no ElevenLabs request is made unless true.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_GUEST_VOICE_ID=Vs5CmVCVJwW4odQS2pVf
ELEVENLABS_MOTHER_VOICE_ID=RU8huomG1ebFQW6nNko3
ELEVENLABS_MIMIC_VOICE_ID=RU8huomG1ebFQW6nNko3
ELEVENLABS_MODEL=eleven_flash_v2_5
